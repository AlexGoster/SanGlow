{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        ".git": true,
        "build": true,
        "dist": true,
        "installer_output": true,
        "*.spec": true,
        "*.zip": true
    },
    "search.exclude": {
        "build": true,
        "dist": true,
        ".venv": true
    },
    "css.validate": true,
    "less.validate": true,
    "scss.validate": true,
    "emmet.includeLanguages": {
        "python": "html",
        "javascript": "html"
    },
    "emmet.snippetsFiles": [
        " snippets.json"
    ],
    "files.associations": {
        "*.qss": "css",
        "*.json": "jsonc"
    },
    "editor.quickSuggestions": {
        "css": true,
        "scss": true
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
}
